spring.application.name=rpg-itens-api
# Configuração do Banco H2 em memória
spring.datasource.url=jdbc:h2:mem:rpgdb
spring.datasource.driverClassName=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=
# Console Web do H2 (acessível em http://localhost:8080/h2-console)
spring.h2.console.enabled=true
spring.h2.console.path=/h2-console
# Hibernate cria/atualiza a tabela automaticamente
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true